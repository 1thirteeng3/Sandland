{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IngestIPCContracts",
  "description": "Contratos de IPC para Ingestão e Processamento de Documentos no Sandland Tauri Core",
  "commands": {
    "ingest_file": {
      "input": {
        "type": "object",
        "properties": {
          "filePath": { "type": "string" }
        },
        "required": ["filePath"]
      },
      "output": { "$ref": "#/definitions/IngestedItemDTO" }
    },
    "ingest_file_content": {
      "input": {
        "type": "object",
        "properties": {
          "fileName": { "type": "string" },
          "content": { "type": "string" }
        },
        "required": ["fileName", "content"]
      },
      "output": { "$ref": "#/definitions/IngestedItemDTO" }
    },
    "ingest_url": {
      "input": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "format": "uri" }
        },
        "required": ["url"]
      },
      "output": { "$ref": "#/definitions/IngestedItemDTO" }
    },
    "list_ingested_items": {
      "input": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object",
            "properties": {
              "query": { "type": "string" },
              "sourceType": { "type": "string" },
              "tag": { "type": "string" }
            }
          }
        }
      },
      "output": {
        "type": "array",
        "items": { "$ref": "#/definitions/IngestedItemDTO" }
      }
    },
    "promote_to_cell": {
      "input": {
        "type": "object",
        "properties": {
          "workspaceId": { "type": "string" },
          "itemId": { "type": "string" },
          "position": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            },
            "required": ["x", "y"]
          }
        },
        "required": ["workspaceId", "itemId"]
      },
      "output": {
        "type": "object",
        "properties": {
          "cellId": { "type": "string" },
          "workspaceId": { "type": "string" }
        },
        "required": ["cellId", "workspaceId"]
      }
    }
  },
  "definitions": {
    "IngestedItemDTO": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "sourceType": { "type": "string", "enum": ["file", "url", "text"] },
        "sourcePath": { "type": "string" },
        "canonicalUri": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": ["string", "null"] },
        "wordCount": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Ingested", "Classified", "Promoted"] },
        "ingestedAt": { "type": "integer" }
      },
      "required": ["id", "sourceType", "sourcePath", "canonicalUri", "title", "wordCount", "tags", "status", "ingestedAt"]
    }
  }
}
